#!/bin/bash
# Minimal unsigned app-bundle entry for a repository checkout.

set -u

# A script has no Mach-O architecture, so LaunchServices may start this bundle
# under Rosetta on Apple Silicon. A translated shell makes the universal
# python pick its x86_64 slice, which then cannot load the venv's arm64
# extension modules ("have 'arm64', need 'x86_64'"). Detect translation and
# re-exec native before anything else runs.
if [[ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" == "1" ]]; then
    exec arch -arm64 "$0" "$@"
fi

REPO_DIR="$(cd "$(dirname "$0")/../../../../.." && pwd)"
VENV_PYTHON="$REPO_DIR/.venv/bin/python"

fail() {
    message="$1"
    printf '\nWaveguide Generator: %s\n' "$message" >&2
    if command -v osascript >/dev/null 2>&1; then
        MESSAGE="$message" osascript -e \
          'display alert "Waveguide Generator could not start" message (system attribute "MESSAGE") as critical'
    fi
    exit 1
}

if [[ ! -f "$REPO_DIR/launchers/statusapp/__main__.py" ]]; then
    fail "The app must stay in launchers/macos inside the Waveguide Generator checkout."
fi

if [[ ! -x "$VENV_PYTHON" ]]; then
    BOOTSTRAP_PYTHON=""
    for candidate in python3.13 python3
    do
        if command -v "$candidate" >/dev/null 2>&1 && \
           "$candidate" -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 13))' >/dev/null 2>&1
        then
            BOOTSTRAP_PYTHON="$(command -v "$candidate")"
            break
        fi
    done
    if [[ -z "$BOOTSTRAP_PYTHON" ]]; then
        fail "The repository environment is missing, and CPython 3.13 was not found as python3. Install Python 3.13 or run installers/macos/install-wg.command."
    fi
    if ! "$BOOTSTRAP_PYTHON" "$REPO_DIR/scripts/bootstrap.py"; then
        fail "The repository environment was missing and python3 could not prepare it. Run installers/macos/install-wg.command for full diagnostics."
    fi
fi

cd "$REPO_DIR" || fail "Could not enter the repository folder: $REPO_DIR"
exec "$VENV_PYTHON" -m launchers.statusapp "$@"
