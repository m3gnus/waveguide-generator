#!/bin/bash
# Minimal unsigned app-bundle entry for a repository checkout. Runtime setup is
# deliberately owned by launch-wg.command so Finder and Terminal cannot drift.

set -u

# A script has no Mach-O architecture, so LaunchServices may start this bundle
# under Rosetta on Apple Silicon. A translated shell makes the universal
# python pick its x86_64 slice, which then cannot load the venv's arm64
# extension modules ("have 'arm64', need 'x86_64'"). Detect translation and
# re-exec native before anything else runs.
if [[ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" == "1" ]]; then
    exec arch -arm64 "$0" "$@"
fi

REPO_DIR="$(cd "$(dirname "$0")/../../../../.." && pwd)"
LAUNCHER="$REPO_DIR/launchers/macos/launch-wg.command"

fail() {
    message="$1"
    printf '\nWaveguide Generator: %s\n' "$message" >&2
    if command -v osascript >/dev/null 2>&1; then
        MESSAGE="$message" osascript -e \
          'display alert "Waveguide Generator could not start" message (system attribute "MESSAGE") as critical'
    fi
    exit 1
}

if [[ ! -x "$LAUNCHER" ]]; then
    fail "The app must stay in launchers/macos inside the Waveguide Generator checkout."
fi

export WG2_FINDER_APP=1
exec "$LAUNCHER" "$@"
