[importlinter]
root_package = server
# Type-only dependencies are part of the architecture too.
exclude_type_checking_imports = false

[importlinter:contract:server-layers]
name = Server layers
type = layers
containers = server
# Highest to lowest. Assembly and API ownership follow the current graph;
# jobs/cadlink coordinate each other, while registry selects solver adapters.
# Pipes require independent siblings; colons permit sibling collaboration.
layers =
    # Developer tools run as their own process; nothing imports them.
    tools
    __main__
    app : cli
    request_middleware
    updates
    diagnostics
    exports | design_io | source_editor
    jobs : cadlink
    engines
    solver
    mesh
    preview
    integration
    # Solve request schemas: read by jobs, the solvers and run provenance alike.
    solve_request
    design
    charts | drivers | settings | workspace | protocol
    platform
    contracts
    # Stdlib-only helper for lazy package exports; imports no server module.
    _lazy_exports
exhaustive = true
exhaustive_ignores =
    # Test modules are clients of production packages, not runtime layers.
    tests
unmatched_ignore_imports_alerting = error
# No ignored edges. When a module needs one in a higher layer, move the shared
# code down to the layer that owns it rather than adding an exception.

# CAD Link lanes (S7-1). Highest to lowest; docs/architecture/CAD-OPERATIONS.md, "Server layout".
# onshape sits above joblane|fusion because its return leg imports joblane and intake. identity
# sits above interpretation by history; the indirect chain that needed it (through design.textcfg
# and jobs.models) is gone. The Onshape routes live in server.exports.onshape_api.
[importlinter:contract:cadlink-lanes]
name = CAD Link lanes
type = layers
containers =
    server.cadlink
layers =
    api
    onshape
    joblane | fusion
    intake
    store : receipts
    identity
    interpretation
    wgreturn : operations : usage : ipc : build_flags
    snapshot_mesh
    limits
    retained_files
exhaustive = true
unmatched_ignore_imports_alerting = error

# Interpretation is pure: no store, no lane, directly or through another server package.
[importlinter:contract:cadlink-interpretation-pure]
name = CAD interpretation reads no store, directly or through another package
type = forbidden
source_modules =
    server.cadlink.interpretation
forbidden_modules =
    server.cadlink.store
    server.cadlink.receipts
    server.cadlink.intake
    server.cadlink.joblane
    server.cadlink.fusion
    server.cadlink.onshape
    server.cadlink.api
    server.jobs.store
    server.platform.sqlite

# Replaces server/tests/test_cadlink_import_direction.py (S7-2); same rule, transitive.
[importlinter:contract:cadlink-preparation-not-shims]
name = Preparation never imports the job admission shims
type = forbidden
source_modules =
    server.cadlink.joblane.preparation
forbidden_modules =
    server.cadlink.joblane.job_shims

[importlinter:contract:contracts-leaf]
name = Shared contracts import no other server package
type = forbidden
source_modules =
    server.contracts
# Wildcard is deliberate here: unlike legacy exceptions, this also covers
# future server packages. Contracts may import their own descendants.
forbidden_modules =
    server.*

# Solver engine adapters are independent: no engine's adapter may import another
# engine's, directly or through a chain. Shared solver utilities and multi-engine
# dispatchers (server.engines.warmup) stay outside these lists. When you add an
# engine-specific module, add it to its engine's list here. None of these
# contracts ignores an edge.

[importlinter:contract:solver-engine-metal]
name = No other engine imports the Metal adapter
type = forbidden
source_modules =
    server.solver.bempp
    server.solver.bempp_imported
    server.solver.bempp_process
    server.solver.bempp_field
    server.solver.bempp_opencl
    server.solver.beat
    server.solver.beat_imported
    server.solver.beat_transducer_imported
    server.solver.beat_adapter.coupled_request
    server.solver.beat_cpu_runtime
    server.solver.official_beat
    server.engines.dryrun
forbidden_modules =
    server.solver.metal
    server.solver.metal_permit

[importlinter:contract:solver-engine-bempp]
name = No other engine imports the BEMPP adapter
type = forbidden
source_modules =
    server.solver.metal
    server.solver.metal_permit
    server.solver.beat
    server.solver.beat_imported
    server.solver.beat_transducer_imported
    server.solver.beat_adapter.coupled_request
    server.solver.beat_cpu_runtime
    server.solver.official_beat
    server.engines.dryrun
forbidden_modules =
    server.solver.bempp
    server.solver.bempp_imported
    server.solver.bempp_process
    server.solver.bempp_field
    server.solver.bempp_opencl

[importlinter:contract:solver-engine-beat]
name = No other engine imports the BEAT adapter
type = forbidden
source_modules =
    server.solver.metal
    server.solver.metal_permit
    server.solver.bempp
    server.solver.bempp_imported
    server.solver.bempp_process
    server.solver.bempp_field
    server.solver.bempp_opencl
    server.engines.dryrun
forbidden_modules =
    server.solver.beat
    server.solver.beat_imported
    server.solver.beat_transducer_imported
    server.solver.beat_adapter.coupled_request
    server.solver.beat_cpu_runtime
    server.solver.official_beat

[importlinter:contract:solver-engine-dryrun]
name = No other engine imports the dry-run adapter
type = forbidden
source_modules =
    server.solver.metal
    server.solver.metal_permit
    server.solver.bempp
    server.solver.bempp_imported
    server.solver.bempp_process
    server.solver.bempp_field
    server.solver.bempp_opencl
    server.solver.beat
    server.solver.beat_imported
    server.solver.beat_transducer_imported
    server.solver.beat_adapter.coupled_request
    server.solver.beat_cpu_runtime
    server.solver.official_beat
forbidden_modules =
    server.engines.dryrun
